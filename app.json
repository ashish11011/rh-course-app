{
  "expo": {
    "name": "RH Healthcare",
    "slug": "rh-healthcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rh_app_logo.png",
    "scheme": "rhhealthcare",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rh.healthcare",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rh_app_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rh.healthcare",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.CAMERA",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/with-gradle-build-settings",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RH Healthcare to access your photos so you can upload your membership card photo."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b286f731-0bbb-4677-ae0a-40e6701107fe"
      }
    },
    "owner": "codeframe",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b286f731-0bbb-4677-ae0a-40e6701107fe"
    }
  }
}
